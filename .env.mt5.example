# ATLAS / MT5 demo connection
# Credentials belong only in the private Windows worker. Never commit them.
MT5_TERMINAL_PATH=C:\\Program Files\\MetaTrader 5\\terminal64.exe
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_MAGIC=260830
MT5_DEVIATION=20

# Mandatory forward-demo safety settings.
ATLAS_LIVE_TRADING=false
ATLAS_DASHBOARD_ONLY=true
ATLAS_ENVIRONMENT=paper

# Continuous paper-trade monitor.
ATLAS_INTERVAL=5m
ATLAS_CANDLE_LIMIT=200
ATLAS_CYCLE_SECONDS=30
ATLAS_MONITOR_TOP_N=12
ATLAS_AUTO_DISCOVER_SYMBOLS=true
ATLAS_PREFERRED_CANONICAL=XAUUSD,XAGUSD,NGAS,EURUSD,XRPUSDT,SOLUSDT
ATLAS_DEMO_MAX_OPEN_POSITIONS=3
ATLAS_DEMO_ACCOUNT_EQUITY=10000
ATLAS_DEMO_LEDGER=data/atlas_demo_ledger.json
ATLAS_SIGNAL_JOURNAL=data/atlas_signals.jsonl
ATLAS_PERSIST_ALL_SIGNALS=false
ATLAS_STRATEGY_MODE=BALANCED
LOG_LEVEL=INFO

# Public read-only dashboard.
ATLAS_PUBLIC_ACCOUNT_LABEL=ATLAS VERIFIED ACCOUNT
ATLAS_PUBLIC_SHOW_BALANCE=true
ATLAS_PUBLIC_SHOW_POSITIONS=true
ATLAS_DASHBOARD_TOP_N=12
ATLAS_HEARTBEAT_SECONDS=30
ATLAS_MARKET_DATA_ENABLED=true
ATLAS_MARKET_DATA_TIMEOUT=8

# Whish Money manual payment review.
ATLAS_WHISH_ENABLED=true
ATLAS_WHISH_RECIPIENT=Samir Taha
ATLAS_WHISH_SUPPORT=0096176420910
ATLAS_WHISH_DB=data/whish_requests.sqlite3

# Optional Supabase control and audit plane. Server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
