# ATLAS / MT5 connection
# IMPORTANT: credentials belong only in the private Windows worker environment.
# Never commit a real login/password to GitHub.
MT5_TERMINAL_PATH=C:\\Program Files\\MetaTrader 5\\terminal64.exe
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_MAGIC=260830
MT5_DEVIATION=20

# Execution gate. Keep false through the complete demo-validation program.
ATLAS_LIVE_TRADING=false
ATLAS_DASHBOARD_ONLY=true
ATLAS_PUBLIC_ACCOUNT_LABEL=ATLAS VERIFIED DEMO
ATLAS_PUBLIC_SHOW_BALANCE=true
ATLAS_PUBLIC_SHOW_POSITIONS=true
ATLAS_DASHBOARD_TOP_N=12

# Wall Street board and financial news. The server-side key is never exposed.
ATLAS_FINNHUB_API_KEY=
ATLAS_MARKET_CACHE_SECONDS=60
ATLAS_MARKET_DATA_DELAYED=true

# Stripe Billing. Use a restricted API key and two recurring monthly Prices:
# ATLAS Reader = $49/month, ATLAS Trader = $99/month. Both have 3-day trials.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ATLAS_STRIPE_PRICE_READER=
ATLAS_STRIPE_PRICE_TRADER=
ATLAS_APP_URL=
ATLAS_CONTACT_URL=

# Supabase control, billing audit, and demo execution journal.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ATLAS_HEARTBEAT_SECONDS=30
LOG_LEVEL=INFO

# Strategy / scanner
ATLAS_STRATEGY_MODE=BALANCED
ATLAS_AUTO_DISCOVER_SYMBOLS=true
