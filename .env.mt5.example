# ATLAS / MT5 connection
# IMPORTANT: credentials belong only in the private Windows worker environment.
# Never commit a real login/password to GitHub.
MT5_TERMINAL_PATH=C:\\Program Files\\MetaTrader 5\\terminal64.exe
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_MAGIC=260830
MT5_DEVIATION=20

# Execution gate.
# Connect a REAL account first and validate the read-only dashboard with this false.
# Set true only on the private MT5 execution worker when live order routing is intended.
ATLAS_LIVE_TRADING=false

# Public subscriber dashboard.
ATLAS_DASHBOARD_ONLY=true
ATLAS_PUBLIC_ACCOUNT_LABEL=ATLAS VERIFIED LIVE
ATLAS_PUBLIC_SHOW_BALANCE=true
ATLAS_PUBLIC_SHOW_POSITIONS=true
ATLAS_DASHBOARD_TOP_N=12

# Subscriber commercial flow.
# ATLAS_CHECKOUT_URL should be a Stripe Payment Link or equivalent hosted checkout.
# Keep empty until a payment provider is configured; /subscribe then falls back to ATLAS_CONTACT_URL.
ATLAS_CHECKOUT_URL=
ATLAS_CONTACT_URL=
ATLAS_SUBSCRIPTION_PRICE=$19/month
ATLAS_SUBSCRIPTION_TRIAL=7-day viewer trial

# Strategy / scanner
ATLAS_STRATEGY_MODE=BALANCED
ATLAS_AUTO_DISCOVER_SYMBOLS=true

# Supabase control/audit plane
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

ATLAS_HEARTBEAT_SECONDS=30
LOG_LEVEL=INFO
