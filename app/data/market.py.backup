import requests


BINANCE_API = "https://api.binance.com/api/v3"


def get_price(symbol: str = "BTCUSDT") -> dict:
    response = requests.get(
        f"{BINANCE_API}/ticker/price",
        params={"symbol": symbol.upper()},
        timeout=10,
    )

    response.raise_for_status()
    data = response.json()

    return {
        "symbol": data["symbol"],
        "price": float(data["price"]),
    }


def get_candles(
    symbol: str = "BTCUSDT",
    interval: str = "1h",
    limit: int = 100,
) -> dict:
    allowed_intervals = {
        "5m",
        "15m",
        "30m",
        "1h",
        "4h",
        "1d",
    }

    if interval not in allowed_intervals:
        raise ValueError(
            f"Unsupported interval. Use one of: {sorted(allowed_intervals)}"
        )

    if not 1 <= limit <= 1000:
        raise ValueError("Limit must be between 1 and 1000.")

    response = requests.get(
        f"{BINANCE_API}/klines",
        params={
            "symbol": symbol.upper(),
            "interval": interval,
            "limit": limit,
        },
        timeout=10,
    )

    response.raise_for_status()

    raw_candles = response.json()

    candles = []

    for candle in raw_candles:
        candles.append(
            {
                "open_time": candle[0],
                "open": float(candle[1]),
                "high": float(candle[2]),
                "low": float(candle[3]),
                "close": float(candle[4]),
                "volume": float(candle[5]),
                "close_time": candle[6],
            }
        )

    return {
        "symbol": symbol.upper(),
        "interval": interval,
        "count": len(candles),
        "candles": candles,
    }


if __name__ == "__main__":
    print(get_price())

    candles = get_candles("BTCUSDT", "1h", 5)

    print(f"Symbol: {candles['symbol']}")
    print(f"Interval: {candles['interval']}")
    print(f"Candles: {candles['count']}")

    for candle in candles["candles"]:
        print(candle)
