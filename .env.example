# ATLAS / FxPro cTrader Demo (MT5 remains paused)
# Keep this file as a template. NEVER commit real credentials.

ATLAS_LIVE_TRADING=false
ATLAS_AUTO_EXECUTION_ENABLED=false
ATLAS_EVOLUTION_WRITES_ENABLED=false
ATLAS_AUTO_RISK_PERCENT=1.0
ATLAS_AUTO_MAX_ENTRY_DRIFT_POINTS=20
ATLAS_AUTO_MAX_CANDIDATE_AGE_SECONDS=60
ATLAS_MT5_MAX_QUOTE_AGE_SECONDS=30
# Private analytical provider snapshot; absent/stale context blocks entries.
ATLAS_AUTO_CONTEXT_FILE=
ATLAS_AUTO_CONTEXT_MAX_AGE_SECONDS=300
ATLAS_DASHBOARD_ONLY=true
ATLAS_PUBLIC_URL=https://justai-atlas.online/
# Public Telegram bot username used for the dashboard navigation link.
ATLAS_TELEGRAM_BOT_USERNAME=JustAI_chatbot
# ATLAS Agent v1 is decision-support + paper-only. Paper writes remain opt-in.
ATLAS_AGENT_PAPER_EXECUTION_ENABLED=false
# Select ctrader for the private cTrader demo workspace. That selection pauses MT5.
ATLAS_BROKER_PROVIDER=ctrader
ATLAS_MT5_CONNECTIONS_PAUSED=true
ATLAS_MT5_WORKSPACE_EMAIL=
# ATLAS owner identity for private cTrader Demo workspace.
# Distinct from public info@justai-atlas.online and Whish admin email.
ATLAS_OWNER_EMAIL=business.samirtaha@gmail.com
ATLAS_OWNER_DASHBOARD_USER=business.samirtaha@gmail.com
# Store the real password privately; /sam uses independent HTTP Basic authentication.
ATLAS_OWNER_DASHBOARD_PASSWORD=
# Put the FxPro cTrader Demo account login in PRIVATE runtime settings only.
ATLAS_CTRADER_DEMO_LOGIN=
ATLAS_CTRADER_CLIENT_ID=
ATLAS_CTRADER_CLIENT_SECRET=
ATLAS_CTRADER_ACCESS_TOKEN=
ATLAS_CTRADER_SYMBOLS=EURUSD
ATLAS_CTRADER_STATE_DIR=data/ctrader
ATLAS_CTRADER_MAX_QUOTE_AGE_SECONDS=30
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=C:\\Program Files\\MetaTrader 5\\terminal64.exe
MT5_MAGIC=260830
MT5_DEVIATION=20

ATLAS_FINNHUB_API_KEY=
ATLAS_MARKET_CACHE_SECONDS=60
ATLAS_MARKET_DATA_DELAYED=true
# Publisher-owned RSS: Federal Reserve, ECB, BBC Arabic. No news API key required.
ATLAS_NEWS_CACHE_SECONDS=300
ATLAS_NEWS_FRESH_SECONDS=86400
ATLAS_TRANSLATION_CACHE_SECONDS=900
# English headlines use the private runtime's existing OPENAI_API_KEY when present.
# Arabic publisher headlines are the fallback; translations are labelled as machine translations.
OPENAI_TRANSLATION_MODEL=gpt-4.1-mini

# ATLAS Right Hand connector bridge.
# Point this to a private bridge/MCP gateway that exposes POST /execute.
# Never expose the token in dashboard responses or client-side JavaScript.
ATLAS_TOOL_BRIDGE_URL=
ATLAS_TOOL_BRIDGE_TOKEN=

# Stripe Live products created for ATLAS ULTIMATE.
# Payment links stay blank until Stripe account verification enables card payments.
ATLAS_STRIPE_PRICE_READER=price_1UE92dLITTksHZzXphyC7fDq
ATLAS_STRIPE_PRICE_PRO=price_1UE92mLITTksHZzXJpaOxS95
ATLAS_STRIPE_LINK_READER=
ATLAS_STRIPE_LINK_PRO=

# Whish Money manual payment intake.
ATLAS_WHISH_ENABLED=true
ATLAS_WHISH_RECIPIENT=76420910
ATLAS_WHISH_SUPPORT=info@justai-atlas.online
ATLAS_WHISH_DB=data/whish_requests.sqlite3

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

