# ATLAS / MetaTrader 5
# Keep this file as a template. NEVER commit real credentials.

ATLAS_LIVE_TRADING=false
ATLAS_DASHBOARD_ONLY=true
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=C:\\Program Files\\MetaTrader 5\\terminal64.exe
MT5_MAGIC=260830
MT5_DEVIATION=20

# Wall Street board and financial news. Keep the data labelled delayed unless
# your provider plan explicitly grants real-time display rights.
ATLAS_FINNHUB_API_KEY=
ATLAS_MARKET_CACHE_SECONDS=60
ATLAS_MARKET_DATA_DELAYED=true

# Stripe Billing. Use a restricted Stripe API key, never a browser-exposed key.
# Create two recurring Stripe Prices and place their IDs below.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ATLAS_STRIPE_PRICE_READER=
ATLAS_STRIPE_PRICE_PRO=
ATLAS_APP_URL=http://127.0.0.1:8000

# Whish Money manual payment intake. Keep disabled until the receiving wallet is verified.
ATLAS_WHISH_ENABLED=false
ATLAS_WHISH_RECIPIENT=Samir Taha
ATLAS_WHISH_SUPPORT=+96176420910
ATLAS_WHISH_DB=data/whish_requests.sqlite3

# Supabase control and billing audit plane. Service-role belongs only on server.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
